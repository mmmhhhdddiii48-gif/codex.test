{
  "name": "nukhba-distribution-pc-trial",
  "version": "1.0.0",
  "description": "Nukhba Distribution desktop customer trial",
  "main": "main.js",
  "author": "Nukhba ERP",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:portable": "electron-builder --win portable --x64 --publish never --config.win.artifactName=Nukhba_Distribution_PC_Trial_3_Days_Portable_${version}_${arch}.${ext}",
    "dist:setup": "electron-builder --win nsis --x64 --publish never --config.win.artifactName=Nukhba_Distribution_PC_Trial_3_Days_Setup_${version}_${arch}.${ext}",
    "dist": "npm run dist:portable && npm run dist:setup"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.nukhba.distribution.trial",
    "productName": "Nukhba Distribution Trial",
    "asar": true,
    "directories": {"output": "dist"},
    "files": ["main.js", "preload.js", "renderer/**/*", "package.json"],
    "win": {},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "النخبة للتوزيع - تجريبي"
    }
  }
}
